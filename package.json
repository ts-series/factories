{
	"name": "@ts-series/factories",
	"version": "1.2.0",
	"license": "(0BSD OR Apache-2.0)",
	"description": "A lightweight TypeScript DSL for generating HTML, SVG and MathML server-side without a template engine.",
	"keywords": [
		"domain-specific",
		"dsl",
		"html",
		"language",
		"mathml",
		"svg",
		"template"
	],
	"engines": {
		"node": ">=26"
	},
	"type": "module",
	"publishConfig": {
		"access": "public"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"onFail": "error"
		}
	},
	"devDependencies": {
		"typescript": "^7.0.2"
	},
	"scripts": {
		"build": "rm -rf dist && tsc",
		"prepublishOnly": "pnpm run build"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./svg": {
			"types": "./dist/svg.d.ts",
			"default": "./dist/svg.js"
		},
		"./mathml": {
			"types": "./dist/mathml.d.ts",
			"default": "./dist/mathml.js"
		}
	},
	"files": [
		"dist",
		"LICENSE-0BSD",
		"LICENSE-APACHE",
		"CONTRIBUTING.md"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/ts-series/factories.git"
	}
}