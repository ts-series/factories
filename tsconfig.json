{
	"compilerOptions": {
		"declaration": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"lib": ["ES2025"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "./src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2025",
		"types": [],
		"verbatimModuleSyntax": true
	},
	"include": ["src/**/*.ts"],
	"exclude": ["src/**/*.test.ts"]
}