{
	"compilerOptions": {
		"declaration": true,
		"esModuleInterop": true,
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"outDir": "./dist",
		"rewriteRelativeImportExtensions": true,
		"rootDir": "./src",
		"skipLibCheck": true,
		"strict": true,
		"target": "ES2025"
	},
	"include": ["src/**/*.ts"]
}